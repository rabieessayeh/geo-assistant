# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored: never commit a real API key.

# --- LLM endpoint (any OpenAI-compatible API) -------------------------------
# Default: a local Ollama server (no key needed).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gpt-oss:20b

# Hosted providers: see the "LLM providers" table in the README, e.g.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=your-model-name

# --- Optional tuning ---------------------------------------------------------
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=4        # retries on HTTP 429 / 5xx, with exponential backoff
# LLM_RETRY_BASE_S=2
# MAX_STEPS=5              # max LLM round-trips per question

# --- Rate limit on /ask (public demos; 0 = no limit) ------------------------
# ASK_RATE_LIMIT=10        # questions per visitor per window
# ASK_GLOBAL_LIMIT=60      # questions per window, all visitors together
# ASK_RATE_WINDOW_S=3600
# TRUST_FORWARDED_FOR=false  # true behind a reverse proxy (e.g. a hosted demo)

# --- Data and logging --------------------------------------------------------
# data/sample = synthetic demo data; data/lux = output of scripts/fetch_lux_data.py
DATA_DIR=data/sample
LOG_LEVEL=INFO
